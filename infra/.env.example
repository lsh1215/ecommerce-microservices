# === Database ===
DB_ROOT_PASSWORD=changeme_root
DB_USERNAME=sa
DB_PASSWORD=changeme_app

# === Domain ===
DOMAIN=example.com
ACME_EMAIL=admin@example.com

# === Traefik Dashboard Auth (htpasswd format) ===
# Generate: echo $(htpasswd -nB admin) | sed -e s/\$/\$\$/g
TRAEFIK_DASHBOARD_AUTH=admin:$$2y$$05$$placeholder

# === Kafka ===
# Must be identical across all 3 brokers and never change once data exists.
# Generate new ID: /opt/kafka/bin/kafka-storage.sh random-uuid
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

# === Docker Images ===
DOCKER_REGISTRY=ghcr.io
DOCKER_IMAGE_PREFIX=ecommerce
DOCKER_TAG=latest
